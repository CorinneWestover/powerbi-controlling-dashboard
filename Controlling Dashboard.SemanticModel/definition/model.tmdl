model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: de-DE
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Date","Product","Reseller","Sales Order","Territory","Sales","Budget"]

ref table Date
ref table Product
ref table Reseller
ref table 'Sales Order'
ref table Territory
ref table Sales
ref table Budget

ref cultureInfo en-US

